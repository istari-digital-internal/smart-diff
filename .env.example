# ── LLM Provider ──────────────────────────────────────────────
# Options: openai | gemini | claude
LLM_PROVIDER=openai

# ── API Keys (fill in the one you are using) ──────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# ── Model overrides (optional) ────────────────────────────────
# Must be one of the models listed for that provider — run
# `python3 smart_diff.py --list-models` to see them. --model overrides these.
# openai: gpt-4o | gpt-4o-mini | gpt-4.1 | gpt-4.1-mini | gpt-4-turbo | o3 | o4-mini
OPENAI_MODEL=gpt-4o
# gemini: gemini-1.5-pro | gemini-1.5-flash | gemini-2.0-flash | gemini-2.5-pro | gemini-2.5-flash
GEMINI_MODEL=gemini-1.5-pro
# claude: claude-opus-5 | claude-opus-4-8 | claude-opus-4-7 | claude-sonnet-5 | claude-sonnet-4-6 | claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5
