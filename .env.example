# ── LLM Provider ──────────────────────────────────────────────
# Options: bedrock | openai_compat
LLM_PROVIDER=bedrock

# ── Auth ──────────────────────────────────────────────────────
# Bearer token for either provider (or pass --auth-tok / job input).
LLM_AUTH_TOKEN=

# ── Bedrock (Converse API) ────────────────────────────────────
# Model ID is set per environment once approved (no default).
BEDROCK_MODEL_ID=
BEDROCK_REGION=us-gov-west-1
# Override for FIPS or VPC endpoints, e.g. https://bedrock-runtime-fips.us-gov-west-1.amazonaws.com
BEDROCK_ENDPOINT=

# SigV4 alternative to the bearer token (standard AWS variables):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── OpenAI-compatible endpoint ────────────────────────────────
LLM_BASE_URL=
LLM_MODEL=
