{
  "module_name": "@istari_utils:smart_diff",
  "module_version": "1.0.2",
  "module_display_name": "Smart Diff",
  "tool": "LLM",
  "tool_versions": ["1.0"],
  "tool_display_name": "LLM",

  "authors": [
    {
      "name": "Istari Engineering",
      "email": "gandalf@istaridigital.com"
    }
  ],

  "functions": {
    "@istari_utils:execute": [
      {
        "entrypoint": "cl_module",
        "run_command": "{entrypoint} Execute --input-file {input_file} --output-file {output_file} --temp-dir {temp_dir}",
        "function_schema": {
          "inputs": {
	    "file1": {
	      "type": "user_model",
	      "validation_types": ["@extension:xlsx", "@extension:docx", "@extension:pdf", "@extension:txt"]
	    },
	    "file2": {
	      "type": "user_model",
	      "validation_types": ["@extension:xlsx", "@extension:docx", "@extension:pdf", "@extension:txt"]
	    },
	    "auth_token": {
	      "type": "auth_info",
	      "validation_types": ["@token:llm"]
	    },
	    "prompt": {
	      "type": "parameter",
              "validation_types": ["@string"]
	    }
          },
          "outputs": [
            {
              "name": "stdout",
              "type": "file",
              "required": true
            },
            {
              "name": "stderr",
              "type": "file",
              "required": true
            },
            {
              "name": "working_directory",
              "type": "directory",
              "required": true
            }
          ]
        },
        "operating_systems": ["Ubuntu 22.04", "RHEL 8", "RHEL 9"],
        "tool_versions": ["1.0"]
      }
    ]
  },

  "module_type": "function",
  "module_checksum": "hash",
  "internal": false,
  "operating_systems": [
    "Ubuntu 22.04",
    "RHEL 8",
    "RHEL 9"
  ],
  "agent_version": ">9.0.0"
}
